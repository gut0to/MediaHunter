# Replace the documentation address, hostname and certificate paths.
# Bind only to a private interface and restrict clients to your own network.
server {
    listen 192.0.2.10:443 ssl;
    server_name hub.example.net;
    ssl_certificate /etc/ssl/mediahunter/fullchain.pem;
    ssl_certificate_key /etc/ssl/mediahunter/privkey.pem;

    allow 192.168.0.0/16;
    allow 10.0.0.0/8;
    deny all;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
