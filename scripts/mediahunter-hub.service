[Unit]
Description=MediaHunter Hub
After=network.target

[Service]
Type=simple
User=mediahunter
Group=mediahunter
WorkingDirectory=/opt/mediahunter/current/apps/hub
Environment=MEDIAHUNTER_DATA_DIR=/var/lib/mediahunter
EnvironmentFile=/etc/mediahunter/hub.env
ExecStart=/usr/bin/env node src/cli.ts serve
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/mediahunter

[Install]
WantedBy=multi-user.target
