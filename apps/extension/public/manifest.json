{
  "manifest_version": 3,
  "name": "MediaHunter",
  "version": "0.2.0",
  "description": "Find media in an active tab and queue downloads on your Windows agent.",
  "action": {"default_popup":"index.html"},
  "background": {"service_worker":"capture.js","type":"module"},
  "side_panel": {"default_path":"index.html?panel=1"},
  "permissions": ["activeTab","scripting","storage","sidePanel"],
  "optional_permissions": ["webRequest","downloads"],
  "optional_host_permissions": ["https://*/*","http://*/*"]
}
